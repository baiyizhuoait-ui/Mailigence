# ===== Mailigence Docker 环境变量模板 =====
# 用法：cp .env.docker.example .env.docker 然后按需编辑，再执行 docker compose up -d。
# 变量命名与 backend/.env.example 保持一致；此文件仅用于 docker compose（env_file）。

# ===== Application =====
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# JSON array of allowed CORS origins (pydantic-settings requires JSON, not CSV)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ===== Database =====
# IMPORTANT: 容器内 host 必须是 docker-compose 中 postgres 服务的名字（postgres），
# 不能是 127.0.0.1 / localhost —— 容器之间无法通过 localhost 互通。
DATABASE_URL=postgresql+psycopg://mailigence:mailigence_dev_pw@postgres:5432/mailigence?sslmode=disable

# ===== Credential encryption =====
# 留空时，backend 容器会在首次启动自动生成并持久化到数据卷（backend/entrypoint.sh），
# 重启不会失效；也可以在这里显式指定（生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"）。
CREDENTIAL_ENCRYPTION_KEY=

# ===== AI analysis =====
# 分析模式：auto（AI优先，失败回退规则）| ai_only | rules_only
AI_ANALYSIS_MODE=auto
# 接入方式：openai（OpenAI 兼容：OpenAI/DeepSeek/Kimi/通义/GLM/Ollama）| anthropic
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Anthropic 专用（仅当 AI_PROVIDER=anthropic）
ANTHROPIC_API_KEY=

# ===== OAuth2 providers (optional) =====
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# 构建 OAuth2 回调地址用的公开 URL
PUBLIC_BASE_URL=http://localhost:8000
