# ===== Application =====
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# JSON array of allowed CORS origins (pydantic-settings requires JSON, not CSV)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ===== Database =====
# psycopg (v3) driver. Use 127.0.0.1 instead of localhost to avoid IPv6 (::1)
# resolution issues, and sslmode=disable to prevent the SSLRequest crash seen
# with portable PostgreSQL builds on Windows. The URL query is a convenience
# hint; the effective sslmode is forced in app/database.py connect_args.
# Matches the README quick-start commands
DATABASE_URL=postgresql+psycopg://mailigence:mailigence_dev_pw@127.0.0.1:5432/mailigence?sslmode=disable

# ===== Credential encryption =====
# Master key used to encrypt mailbox credentials at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: keep this secret. Losing it makes stored credentials unrecoverable.
CREDENTIAL_ENCRYPTION_KEY=

# ===== AI analysis =====
# Analysis mode: auto (AI first, fall back to rules) | ai_only | rules_only
AI_ANALYSIS_MODE=auto
# Provider: openai (OpenAI-compatible, covers OpenAI/DeepSeek/Kimi/Qwen/GLM/Ollama) | anthropic
AI_PROVIDER=openai
# OpenAI-compatible endpoints (Ollama local: http://localhost:11434/v1)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Anthropic-specific (only when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ===== OAuth2 providers (optional; enables OAuth2 for Gmail / Outlook) =====
# Gmail OAuth2 authenticates over IMAP (XOAUTH2); Outlook OAuth2 reads mail via
# the Microsoft Graph REST API (scope: User.Read Mail.Read offline_access ...).
# Leave blank to fall back to app-specific passwords (the universal baseline).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Public URL used to build OAuth2 redirect URIs
PUBLIC_BASE_URL=http://localhost:8000
